# Only dependency declarations and application files belong in the image.
**
!cpanfile
!APIProxy/
!APIProxy/**

# Exclude generated files and credentials even if placed inside APIProxy/.
**/.git
**/.env
**/.env.*
**/gha-creds-*.json
**/local
**/blib
**/logs
**/log
**/*.log
**/Makefile
**/MYMETA.*
**/pm_to_blib
**/APIProxy-*
**/*.swp
